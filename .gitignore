# =============================================================
# Terraform
# =============================================================
# tfvars contain email addresses and environment-specific values
# — never commit. Use terraform.tfvars.example as a template.
*.tfvars

# Terraform working directory and state files
.terraform/
*.tfstate
*.tfstate.backup
terraform.tfplan
CLAUDE.md
# NOTE: .terraform.lock.hcl is intentionally NOT ignored.
# It is the dependency lock file and SHOULD be committed,
# same as package-lock.json in Node projects.

